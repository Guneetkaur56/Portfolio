{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Vite dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run portfolio dev server",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd run dev -- --host 127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Install and run portfolio",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd install && npm.cmd run dev -- --host 127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Install and run portfolio compat",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd install --legacy-peer-deps && npm.cmd run dev -- --host 127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Vite with compatible TypeScript",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd install --no-save --legacy-peer-deps typescript@5.9.3 && npm.cmd run dev -- --host 127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Rebuild esbuild and serve",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"npm.cmd rebuild esbuild && npm.cmd run dev -- --host 127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}